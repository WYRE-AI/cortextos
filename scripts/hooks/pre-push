#!/usr/bin/env bash
# pre-push hook — installed by scripts/setup-hooks.sh
#
# Runs the leak-guard scan, then npm run build && npm test, before any push.
# Fails the push if any step fails, so broken code or an operational leak
# never reaches CI.
#
# To bypass in an emergency (last resort):
#   git push --no-verify
# Do NOT use --no-verify routinely. Fix the error instead.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ---------------------------------------------------------------------------
# Leak guard — local fail-fast mirror of .github/workflows/leak-guard.yml.
# CI's leak-guard.sh is the real backstop (covers fork PRs and UI-merges this
# hook can't see) and stays required regardless; this just catches the same
# class before the push leaves the machine, same diff-filter (ACMR) as CI.
#
# git feeds pre-push one line per pushed ref on stdin:
#   <local ref> <local sha1> <remote ref> <remote sha1>
# local sha1 all-zero = a delete, nothing to scan. remote sha1 all-zero = a
# brand-new ref with no remote history to diff against — fall back to the
# merge-base with origin/main (best-effort; if that ref isn't resolvable
# locally, skip the scan for that ref rather than fail the push on a hook
# environment gap CI will still catch).
# ---------------------------------------------------------------------------
zero_sha='0000000000000000000000000000000000000000'
leak_files=""

# shellcheck disable=SC2034 # local_ref/remote_ref are unused but must be
# read to consume git's 4-field pre-push stdin format correctly.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero_sha" ] && continue
  if [ "$remote_sha" = "$zero_sha" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    [ -z "$base" ] && continue
  else
    base="$remote_sha"
  fi
  files="$(git diff --name-only --diff-filter=ACMR "$base".."$local_sha" 2>/dev/null || true)"
  [ -n "$files" ] && leak_files="$leak_files
$files"
done

leak_files="$(printf '%s\n' "$leak_files" | sed '/^$/d' | sort -u)"

if [ -n "$leak_files" ]; then
  echo "[pre-push] Running leak-guard..."
  if ! printf '%s\n' "$leak_files" | xargs .github/scripts/leak-guard.sh; then
    echo "" >&2
    echo "[pre-push] leak-guard found an operational leak. Fix it before pushing (see above)." >&2
    echo "[pre-push] Push aborted." >&2
    exit 1
  fi
fi

echo "[pre-push] Running build..."
if ! npm run build --silent; then
  echo ""
  echo "[pre-push] Build failed. Fix the error before pushing." >&2
  echo "[pre-push] Push aborted." >&2
  exit 1
fi

echo "[pre-push] Running tests..."
if ! npm test --silent; then
  echo ""
  echo "[pre-push] Tests failed. Fix the failing tests before pushing." >&2
  echo "[pre-push] Push aborted." >&2
  exit 1
fi

echo "[pre-push] Build and tests passed. Pushing..."
