#!/usr/bin/env bash
# bin/gh-shim/gh
#
# Transparent PATH shim for `gh`. Installed by prepending this directory to
# PATH in each agent's .env (see agent-pty.ts's buildPtyEnv/applyEnvAssignment
# -- PATH there is a prepend, never a replacement). Never installed in
# Aaron's own interactive shell.
#
# For a call targeting an ALLOWLISTED org (one the wyre-agent-fleet GitHub
# App is actually installed on), mints -- or reuses a short-lived cached --
# installation token and runs the real `gh` with GH_TOKEN set, so the
# resulting commit/PR/comment is attributed to the bot instead of whatever
# personal account is logged into `gh` on this shared Mac.
#
# For anything else (unrelated org, ambiguous, no git checkout, --help,
# `gh auth status`, etc.) this FAILS OPEN: passes straight through to the
# real `gh` with today's ambient auth, silently -- ordinary `gh` usage for
# something outside the fleet's own repos must keep working exactly as
# before. If the target IS on the allowlist but minting fails (network
# blip, secrets unavailable), this REFUSES instead (nonzero exit, no real
# `gh` invocation at all) -- the original design fell back to ambient auth
# here too, loudly, but that's the exact silent-impersonation shape this
# shim exists to close: #210 (2026-10-02) was genuinely merged BY the
# shared Mac's personal asachs01 login after a fallback just like that one
# fired. "A refusing guard beats a warning one" (this org's 2026-08-17
# doctrine) -- see task_1790244063432.
#
# FLEET-ADJACENT, NOT ALLOWLISTED (task_1793545606849_47060600, 2026-11-01):
# wyre-technology is this fleet's own origin org (cortextos/conduit both
# resolve there) but is NOT on ALLOWLIST -- nobody has confirmed the
# wyre-agent-fleet App is even installed there, so treating it like
# WYRE-AI (mint-or-refuse for everything) would convert every ordinary
# wyre-technology READ into a refusal the moment this ships, unverifiable
# from this seat (cortex-secret's own OP_SERVICE_ACCOUNT_TOKEN gap blocks
# testing the mint path at all right now -- see task_1793058444001). A
# blanket fail-open for it is also wrong: that's what let boss's 2026-11-01
# stale-pr sweep read it under ambient personal auth and over-generalize a
# "gh is working again" conclusion (retracted same hour) -- a false-green
# LIVENESS hazard, not an attribution one, since a read changes nothing on
# GitHub. The real, irreversible hazard is a WRITE landing under ambient
# auth for an org this fleet actually has repos in -- the #210 shape,
# scoped to one more org. So: reads keep failing open exactly as before
# (FLEET_ADJACENT_READONLY_ORGS behaves identically to any other
# non-allowlisted org for a read); a recognized WRITE verb instead REFUSES,
# same as a mint failure does for an allowlisted org, but for a different
# reason (there is no mint path configured for this org at all -- refusing
# is the only safe option, not "mint or refuse"). is_write_call() below is
# a known-verb DENYLIST (not a read allowlist) deliberately: an
# unrecognized future `gh` subcommand falls through as a read (fail-open),
# which matches point (a) above -- ordinary gh use must keep working --
# and keeps this change narrow rather than risking a new false refusal on
# some verb nobody enumerated. The residual risk (a brand-new write verb
# this list hasn't caught up to yet) is accepted, not unlimited: it only
# ever degrades back to today's existing fail-open behavior, never worse.
#
# See bus/gh-bot.sh (the explicit opt-in sibling; same org-resolution
# shape, no allowlist since it's explicit) and task_1790244063432.
set -euo pipefail

# The standard PATH-shim trick: strip this script's own directory out of a
# COPY of PATH before resolving `gh`, so we find the real binary instead of
# recursing into ourselves. Compares each PATH entry's REAL (symlink- and
# trailing-slash-resolved) directory against this script's real directory,
# not a literal string match, so a differently-spelled or symlinked PATH
# entry for this same directory is still caught -- this runs on every `gh`
# call fleet-wide, so the common exact-match case is checked first (zero
# forks) and only a non-matching entry pays for the realpath resolution.
realpath_of() { (cd "$1" 2>/dev/null && pwd -P); } # empty output on a missing dir
SHIM_DIR="$(realpath_of "$(dirname "${BASH_SOURCE[0]}")")"
CLEAN_PATH=""
IFS=: read -ra _path_entries <<< "$PATH"
for _dir in "${_path_entries[@]}"; do
  if [[ "$_dir" == "$SHIM_DIR" ]]; then continue; fi
  if [[ -n "$_dir" && "$(realpath_of "$_dir")" == "$SHIM_DIR" ]]; then continue; fi
  CLEAN_PATH="${CLEAN_PATH:+$CLEAN_PATH:}$_dir"
done
REAL_GH="$(PATH="$CLEAN_PATH" command -v gh || true)"
if [[ -z "$REAL_GH" || "$(realpath_of "${REAL_GH%/*}")" == "$SHIM_DIR" ]]; then
  echo "gh-shim: no real 'gh' binary found on PATH behind this shim" >&2
  exit 127
fi

ALLOWLIST=("WYRE-AI")
# See the FLEET-ADJACENT, NOT ALLOWLISTED comment block above for why this
# is a separate list from ALLOWLIST rather than an addition to it.
FLEET_ADJACENT_READONLY_ORGS=("wyre-technology")
CACHE_DIR="${CTX_ROOT:-$HOME/.cortextos}/state/gh-shim"
CACHE_TTL_SECS=2700 # 45min -- comfortably inside gh-app-token's ~1h token life

is_allowlisted() {
  local needle="${1,,}"
  for org in "${ALLOWLIST[@]}"; do
    [[ "${org,,}" == "$needle" ]] && return 0
  done
  return 1
}

is_fleet_adjacent_readonly() {
  local needle="${1,,}"
  for org in "${FLEET_ADJACENT_READONLY_ORGS[@]}"; do
    [[ "${org,,}" == "$needle" ]] && return 0
  done
  return 1
}

# Known WRITE verbs per `gh` noun group, i.e. a DENYLIST not a read
# allowlist -- see the design note above FLEET_ADJACENT_READONLY_ORGS for
# why an unrecognized noun+verb combination deliberately falls through as
# a read. `gh api` is handled separately: a write if an explicit non-GET
# --method/-X is given, or any body-setting flag is present (gh itself
# defaults an `api` call's method to POST once a body field is supplied via
# -f/-F/--raw-field/--input, even with no explicit --method).
is_write_call() {
  local -a positional=()
  local prev="" arg
  for arg in "$@"; do
    if [[ "$prev" == "--repo" || "$prev" == "-R" || "$prev" == "--method" || "$prev" == "-X" ]]; then
      prev="$arg"
      continue
    fi
    case "$arg" in
      -*) prev="$arg" ;;
      *) positional+=("$arg"); prev="$arg" ;;
    esac
  done
  local noun="${positional[0]:-}" verb="${positional[1]:-}"

  if [[ "$noun" == "api" ]]; then
    local a prev2=""
    for a in "$@"; do
      if [[ "$prev2" == "--method" || "$prev2" == "-X" ]]; then
        [[ "${a^^}" != "GET" ]] && return 0
      fi
      case "$a" in
        --method=*) [[ "${a#--method=}" != [Gg][Ee][Tt] ]] && return 0 ;;
        -f|-F|--raw-field|--input|-f*|-F*) return 0 ;;
      esac
      prev2="$a"
    done
    return 1
  fi

  case "$noun" in
    pr|issue)
      case "$verb" in
        create|edit|close|reopen|merge|comment|review|ready|lock|unlock|delete|transfer|pin|unpin) return 0 ;;
        *) return 1 ;;
      esac ;;
    repo)
      case "$verb" in
        create|delete|edit|archive|unarchive|rename|fork|set-default|deploy-key) return 0 ;;
        *) return 1 ;;
      esac ;;
    release)
      case "$verb" in
        create|edit|delete|upload|delete-asset) return 0 ;;
        *) return 1 ;;
      esac ;;
    workflow)
      case "$verb" in
        run|enable|disable) return 0 ;;
        *) return 1 ;;
      esac ;;
    run)
      case "$verb" in
        rerun|cancel|delete) return 0 ;;
        *) return 1 ;;
      esac ;;
    gist|label)
      case "$verb" in
        create|edit|delete) return 0 ;;
        *) return 1 ;;
      esac ;;
    *)
      return 1 ;;
  esac
}

# [HOST/]OWNER/REPO -> OWNER (strips an optional leading host segment, e.g.
# "github.com/WYRE-AI/conduit" or the attached "-R" form below).
owner_of() {
  local val="$1"
  if [[ "$val" == */*/* ]]; then val="${val#*/}"; fi
  printf '%s' "${val%%/*}"
}

# 1) --repo/-R OWNER/REPO anywhere in the args (gh's own flag for "not
#    inside a checkout" calls -- e.g. `gh pr view 123 --repo OWNER/REPO`).
#    Handles --repo=OWNER/REPO, an attached -ROWNER/REPO, and an optional
#    HOST/ prefix on any of these forms.
ORG=""
prev=""
for arg in "$@"; do
  if [[ "$prev" == "--repo" || "$prev" == "-R" ]]; then
    ORG="$(owner_of "$arg")"
    break
  fi
  case "$arg" in
    --repo=*) ORG="$(owner_of "${arg#--repo=}")"; break ;;
    -R?*) ORG="$(owner_of "${arg#-R}")"; break ;;
  esac
  # 2) `gh api repos/OWNER/REPO/...` — the canonical form for calls made
  # outside any checkout (no --repo flag at all). Without this, e.g.
  # `gh api repos/WYRE-AI/conduit/pulls/123/comments` from a non-checkout
  # cwd falls through to the origin-remote check below, finds nothing, and
  # silently uses ambient auth — reproducing the exact bug this shim
  # exists to fix, with no signal (unlike bus/gh-bot.sh, which dies loudly
  # on an undetermined org). Also accepts a leading slash (`gh api` allows
  # both `repos/...` and `/repos/...`).
  if [[ "$arg" =~ ^/?repos/([^/]+)/ ]]; then
    ORG="${BASH_REMATCH[1]}"
    break
  fi
  prev="$arg"
done

# 3) fall back to the cwd's origin remote
if [[ -z "$ORG" ]]; then
  REMOTE_URL="$(git remote get-url origin 2>/dev/null || true)"
  ORG="$(printf '%s' "$REMOTE_URL" | sed -nE 's#.*[:/]([^/]+)/[^/]+(\.git)?$#\1#p')"
fi

# GHCR/package-registry calls (`gh api .../packages/...`) are excluded from
# bot-token routing even for an allowlisted org. The App's package
# permission ("packages: write" on the installation) does not reliably
# cover the same surface a personal account's package scopes do -- caught
# 2026-09-24 (maintainer, task via bus msg 1790266708602) when a real
# `orgs/WYRE-AI/packages/container/.../versions` query 404'd through the
# bot token in a case where personal auth is expected to succeed. There is
# also no attribution benefit here to weigh against that risk: package
# reads create no commit/PR/comment, so intercepting them serves no part
# of this shim's actual purpose.
for arg in "$@"; do
  if [[ "$arg" == *"/packages/"* || "$arg" == packages/* ]]; then
    exec "$REAL_GH" "$@"
  fi
done

# Fleet-adjacent but not allowlisted (today: wyre-technology): a READ keeps
# failing open exactly like any other non-allowlisted org, below. A
# recognized WRITE refuses outright -- no mint attempt (none is configured
# for this org tier) and no ambient-auth fallback, the same #210 shape
# ALLOWLIST's own mint-failure branch refuses for a different reason.
if [[ -n "$ORG" ]] && is_fleet_adjacent_readonly "$ORG" && is_write_call "$@"; then
  echo "gh-shim: REFUSING -- \"$ORG\" is fleet-adjacent but not on the mint allowlist, and this looks like a WRITE (would run under today's ambient gh auth, the exact silent-impersonation shape #210 closed). Reads to this org still pass through unchanged; a write here needs a human decision, not an ambient fallback. See task_1793545606849_47060600." >&2
  cortextos bus log-event error gh_shim_fleet_adjacent_write_refused error --meta "{\"org\":\"$ORG\"}" >/dev/null 2>&1 || true
  exit 1
fi

# Not our own org (or undeterminable) -- ordinary gh usage, pass through
# silently. This is the common case (foreign repos, --help, auth status,
# ambiguous cwd) and must never warn.
if [[ -z "$ORG" ]] || ! is_allowlisted "$ORG"; then
  exec "$REAL_GH" "$@"
fi

CACHE_FILE="$CACHE_DIR/${ORG,,}.token"
NOW="$(date +%s)"
TOKEN=""
if [[ -f "$CACHE_FILE" ]]; then
  MINT_EPOCH=""
  { read -r MINT_EPOCH; read -r TOKEN; } < "$CACHE_FILE" 2>/dev/null || true
  if [[ ! "$MINT_EPOCH" =~ ^[0-9]+$ ]] || (( NOW - MINT_EPOCH >= CACHE_TTL_SECS )); then
    TOKEN=""
  fi
fi

if [[ -z "$TOKEN" ]]; then
  if TOKEN="$(cortex-secret run --context conduit -- cortextos bus gh-app-token --org "$ORG" 2>/dev/null)" && [[ -n "$TOKEN" ]]; then
    # Atomic cache write: write to a private temp file in the same
    # directory, then rename over the cache file. rename() is atomic on
    # the same filesystem, so a concurrent reader (another agent's `gh`
    # call) always sees either the old complete file or the new complete
    # file, never a partial write -- no locking needed. mkdir here (not
    # unconditionally at startup) since a warm cache hit never needs it.
    mkdir -p "$CACHE_DIR" 2>/dev/null || true
    if TMP="$(mktemp "$CACHE_DIR/.${ORG,,}.token.XXXXXX" 2>/dev/null)"; then
      { printf '%s\n%s\n' "$NOW" "$TOKEN" > "$TMP" && mv -f "$TMP" "$CACHE_FILE"; } 2>/dev/null \
        || rm -f "$TMP"
    fi
  else
    echo "gh-shim: REFUSING -- failed to mint a wyre-agent-fleet token for org \"$ORG\" and will NOT fall back to ambient gh auth (that silent-impersonation shape is what this shim exists to close -- see #210, 2026-10-02). Fix the credential, don't retry around this: cortex-secret run --context conduit -- cortextos bus gh-app-token --org \"$ORG\"" >&2
    # Also log-event, not just stderr -- a stderr line inside some other
    # command's PTY transcript is easy to miss for days (this org's own
    # documented failure shape for silent misattribution). Best-effort:
    # if cortextos itself is what's failing, this may also fail; that's
    # fine, the stderr warning above still fired.
    cortextos bus log-event error gh_shim_mint_failed error --meta "{\"org\":\"$ORG\"}" >/dev/null 2>&1 || true
    exit 1
  fi
fi

GH_TOKEN="$TOKEN" exec "$REAL_GH" "$@"
